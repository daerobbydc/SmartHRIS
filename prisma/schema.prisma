// ==================== WORKFORCE MANAGEMENT ====================
model ShiftSwapRequest {
  id              String           @id @default(cuid())
  requesterId     String
  requester       Employee         @relation("ShiftSwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipientId     String
  recipient       Employee         @relation("ShiftSwapRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  requesterDate   DateTime         @db.Date
  recipientDate   DateTime         @db.Date
  reason          String?          @db.Text
  status          ShiftSwapStatus  @default(PENDING_COLLEAGUE)
  colleagueNote   String?          @db.Text
  approvedBy      String?
  managerNote     String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([requesterId])
  @@index([recipientId])
  @@index([status])
}

model BusinessTrip {
  id                 String              @id @default(cuid())
  employeeId         String
  employee           Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title              String
  destination        String
  purpose            String              @db.Text
  startDate          DateTime            @db.Date
  endDate            DateTime            @db.Date
  estimatedBudget    Decimal             @default(0) @db.Decimal(12, 2)
  cashAdvanceAmount  Decimal             @default(0) @db.Decimal(12, 2)
  status             BusinessTripStatus  @default(PENDING)
  approvedBy         String?
  rejectionReason    String?             @db.Text
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  settlements        CashAdvanceSettlement[]

  @@index([employeeId])
  @@index([status])
}

model CashAdvanceSettlement {
  id                 String              @id @default(cuid())
  businessTripId     String
  businessTrip       BusinessTrip        @relation(fields: [businessTripId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  totalReceipts      Decimal             @db.Decimal(12, 2)
  advanceAmount      Decimal             @db.Decimal(12, 2)
  differenceAmount   Decimal             @db.Decimal(12, 2) // >0 reimbursement, <0 refund
  receiptUrls        String?             @db.Text
  notes              String?             @db.Text
  status             BusinessTripStatus  @default(PENDING)
  approvedBy         String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([businessTripId])
  @@index([employeeId])
}

enum ShiftSwapStatus {
  PENDING_COLLEAGUE
  PENDING_MANAGER
  APPROVED
  REJECTED
  CANCELLED
}

enum BusinessTripStatus {
  PENDING
  APPROVED
  REJECTED
  SETTLED
  CANCELLED
}

// ==================== LMS & TALENT MANAGEMENT ====================
model LmsCourse {
  id          String         @id @default(cuid())
  title       String
  description String         @db.Text
  category    String
  level       String         @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  totalHours  Int            @default(1)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  modules     LmsModule[]
  enrollments LmsEnrollment[]

  @@index([category])
}

model LmsModule {
  id          String    @id @default(cuid())
  courseId    String
  course      LmsCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  contentType String    @default("VIDEO") // VIDEO, DOCUMENT, QUIZ
  contentUrl  String?   @db.Text
  bodyText    String?   @db.Text
  order       Int       @default(1)
  durationMin Int       @default(15)
  createdAt   DateTime  @default(now())

  @@index([courseId])
}

model LmsEnrollment {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  courseId        String
  course          LmsCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress        Int       @default(0) // 0 - 100%
  score           Decimal?  @db.Decimal(5, 2)
  isCompleted     Boolean   @default(false)
  certificateCode String?   @unique
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([employeeId, courseId])
  @@index([employeeId])
  @@index([courseId])
}

model TalentMatrix9Box {
  id                String   @id @default(cuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  performanceRating Int      // 1 (Low), 2 (Medium), 3 (High)
  potentialRating   Int      // 1 (Low), 2 (Medium), 3 (High)
  boxNumber         Int      // 1 - 9
  boxCategory       String   // Star, High Potential, Solid Professional, etc.
  notes             String?  @db.Text
  assessedBy        String?
  year              Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([employeeId, year])
  @@index([employeeId])
  @@index([boxNumber])
}

model PaklaringDocument {
  id             String   @id @default(cuid())
  employeeId     String   @unique
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentNumber String   @unique
  issueDate      DateTime @db.Date
  hireDate       DateTime @db.Date
  exitDate       DateTime @db.Date
  lastPosition   String
  reasonForExit  String?
  hrSignName     String   @default("Budi Santoso, M.Psi")
  hrSignTitle    String   @default("Head of Human Resources")
  createdAt      DateTime @default(now())

  @@index([employeeId])
}

// ==================== BIOMETRIC & FINGERPRINT INTEGRATION ====================
model BiometricDevice {
  id          String         @id @default(cuid())
  deviceCode  String         @unique
  name        String
  ipAddress   String?
  location    String?
  secretToken String         @default(cuid())
  status      String         @default("ONLINE")
  lastSyncAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  logs        BiometricLog[]
}

model BiometricLog {
  id          String           @id @default(cuid())
  deviceId    String
  device      BiometricDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employeePin String
  employeeId  String?
  employee    Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  timestamp   DateTime
  scanType    String           @default("AUTOMATIC") // CHECK_IN, CHECK_OUT, AUTOMATIC
  verifyMode  String           @default("FINGERPRINT") // FINGERPRINT, FACE, CARD, PASSWORD
  isProcessed Boolean          @default(false)
  rawPayload  String?          @db.Text
  createdAt   DateTime         @default(now())

  @@index([deviceId])
  @@index([employeePin])
  @@index([timestamp])
}



